
<Project>
  <PropertyGroup>
    <NoWarn>CS1591;CS0649;CS8632;NU1608;NU1109</NoWarn>
    <Version>6.0.0</Version>
    <LangVersion>preview</LangVersion>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <PackageTags>AspNetCore, Verify</PackageTags>
    <Description>Extends Verify (https://github.com/VerifyTests/Verify) to allow verification of AspNetCore bits.</Description>
    <ResolveAssemblyReferencesSilent>true</ResolveAssemblyReferencesSilent>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-08</Verify_SponsorshipExemptionUntil>
    <!-- In Debug the .NET 11 SDK gives every Web SDK project a hot reload JS initializer. Those from
         referenced Web SDK projects reach Tests without endpoints and fail its build. Nothing here
         uses hot reload. -->
    <EnableHotReloadInRuntimeConfigDevFile>false</EnableHotReloadInRuntimeConfigDevFile>
  </PropertyGroup>
</Project>